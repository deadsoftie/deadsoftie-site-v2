---
layout: null
permalink: /essays.json
---
[
{% for e in site.essays %}
  {
    "title": {{ e.title | jsonify }},
    "url":   {{ e.url | relative_url | jsonify }},
    "date":  {{ e.date | date: "%Y-%m-%d" | jsonify }},
    "year":  {{ e.date | date: "%Y" | jsonify }},
    "tags":  {{ e.tags | jsonify }},
    "summary": {{ e.summary | jsonify }},
    "words": {{ e.content | strip_html | number_of_words }},
    "pinned": {{ e.pinned | default: false | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
